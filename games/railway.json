{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "npm run games:build",
    "watchPatterns": ["games/**", "playables/**", "shared/**"]
  },
  "deploy": {
    "startCommand": "npm run games:start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
